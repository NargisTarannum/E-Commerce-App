# Copy to .env.local and fill in real values. Never commit .env.local.

# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/
# Database name for users (default: authDB)
MONGODB_DB=authDB

# Optional: only if the app fails with "querySrv ECONNREFUSED" (your machine's DNS
# refuses SRV lookups). Makes Node use public DNS for the MongoDB hostname.
# MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1

# Random string, 32+ characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
